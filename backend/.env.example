# Copia este archivo como backend/.env y completa los valores.
# Supabase > Project Settings > API (o Data API)
SUPABASE_URL=https://dveissdkttqrgkuwmsdu.supabase.co
# Llave SECRETA (service_role, o la nueva "secret" sb_secret_...). Nunca en el frontend ni en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# Orígenes permitidos del frontend, separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sucursal a usar si el reporte no la indica, y zona horaria de sus fechas
DEFAULT_SUCURSAL=VERACRUZ
REPORT_UTC_OFFSET=-06:00
